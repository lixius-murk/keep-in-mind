<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.ProjectDetailsActivity"
    android:background="@color/white">

  <ImageView
      android:id="@+id/project_cover"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintRight_toRightOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      android:layout_marginTop="20dp"
      android:layout_marginRight="20dp"
      app:srcCompat="@mipmap/ic_placeholder" />
  <TextView
      android:id="@+id/project_name"

      android:text="name_project"
      style="@style/mainText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintRight_toLeftOf="@id/project_cover"
      app:layout_constraintTop_toTopOf="parent"
      android:layout_marginTop="20dp"
      android:layout_marginRight="10dp"

    />
  <TextView
      android:id="@+id/project_start_date"

      android:text="start_date"
      style="@style/bottomText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintRight_toLeftOf="@id/project_cover"
      app:layout_constraintTop_toBottomOf="@id/project_name"
      android:layout_marginTop="10dp"
      android:layout_marginRight="10dp"

    />
  <TextView
      android:id="@+id/project_end_date"

      android:text="end_date"
      style="@style/bottomText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintRight_toLeftOf="@id/project_cover"
      app:layout_constraintTop_toBottomOf="@id/project_start_date"
      android:layout_marginTop="10dp"
      android:layout_marginRight="10dp"

    />
  <ImageButton
      android:id="@+id/close_btn"
      android:src="@drawable/close_black_ic"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@null"
      app:layout_constraintLeft_toLeftOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      android:layout_marginTop="20dp"
      android:layout_marginLeft="20dp"
      />


  <com.google.android.material.tabs.TabLayout
      android:id="@+id/extras_tabs"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:background="@color/navi_blue"
      app:layout_constraintTop_toBottomOf="@id/project_end_date"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <androidx.viewpager2.widget.ViewPager2
      android:id="@+id/extras_pager"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@color/white_dark"
      app:layout_constraintTop_toBottomOf="@id/extras_tabs"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>