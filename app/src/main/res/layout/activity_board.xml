<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".activities.BoardActivity">


    <LinearLayout
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="632dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!--for having 2 text spaces i go without real btn-->


        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/rounded_shape"
            android:backgroundTint="@color/status_ready"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:paddingTop="5dp"
                android:text="to start"
                android:textAppearance="@style/mainText" />

            <TextView
                android:id='@+id/ready_amnt_text'
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="15dp"
                android:text="n tasks"
                android:textAppearance="@style/bottomText" />

        </FrameLayout>
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="20dp"

            android:background="@drawable/rounded_shape"
            android:backgroundTint="@color/status_in_progress"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:paddingTop="5dp"
                android:text="in process"
                android:textAppearance="@style/mainText" />

            <TextView
                android:id='@+id/process_amnt_text'

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="15dp"
                android:text="n tasks"
                android:textAppearance="@style/bottomText" />

        </FrameLayout>
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="20dp"

            android:background="@drawable/rounded_shape"
            android:backgroundTint="@color/status_on_hold"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:paddingTop="5dp"
                android:text="on hold"
                android:textAppearance="@style/mainText" />

            <TextView
                android:id='@+id/hold_amnt_text'

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="15dp"
                android:text="n tasks"
                android:textAppearance="@style/bottomText" />

        </FrameLayout>
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_shape"
            android:backgroundTint="@color/status_finished"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:paddingTop="5dp"
                android:text="finished"
                android:textAppearance="@style/mainText" />

            <TextView
                android:id='@+id/finished_amnt_text'

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="15dp"
                android:text="n tasks"
                android:textAppearance="@style/bottomText" />

        </FrameLayout>


    </LinearLayout>


    <ImageButton
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:id="@+id/add_folder_btn"
        app:layout_constraintBottom_toBottomOf="@id/board"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@null"
        android:contentDescription="add new folder button"
        android:src="@drawable/add_ic"
        >
    </ImageButton>
    <ImageButton
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:id="@+id/add_proj_btn"
        app:layout_constraintBottom_toBottomOf="@id/board"
        app:layout_constraintLeft_toLeftOf="parent"
        android:background="@null"
        android:contentDescription="add new project button"
        android:src="@drawable/add_ic"
        >
    </ImageButton>


    <ScrollView
        android:id="@+id/folders_sv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/board"
        >

    <LinearLayout
            android:id="@+id/folders_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            android:padding="8dp">


        </LinearLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>